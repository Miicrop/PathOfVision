{
  "productName": "Path of Vision",
  "version": "0.1.1",
  "identifier": "io.github.miicrop.pov",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "miicrop",
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../data/mods.json": "data/mods.json",
      "../data/labels.json": "data/labels.json",
      "../data/keywords.json": "data/keywords.json",
      "../data/profiles/default.json": "data/profiles/default.json",
      "../data/profiles/empty.json": "data/profiles/empty.json",
      "../modules/altar/assets/": "modules/altar/assets/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4RUE1QjAzRDA5QzM5MTcKUldRWE9aelFBMXZxQ0RtK3VlcmNLNENMZUF2M2JNRzhKQ1A5MnBIK1hFSnpQVk1XOUN6T1hiMEMK",
      "endpoints": ["https://github.com/Miicrop/PathOfVision/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
